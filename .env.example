AGROGAMI_ENV=development
AGROGAMI_DATABASE_URL=sqlite:///private_data/agrogami.db
AGROGAMI_PRIVATE_DATA_DIR=private_data
AGROGAMI_MODEL_CACHE_DIR=model_cache
AGROGAMI_LOG_LEVEL=INFO
AGROGAMI_DEMO_MODE=true
AGROGAMI_ENABLE_REAL_MODELS=false
# Local demo token-to-role JSON; set secrets only in ignored .env, never commit real tokens.
AGROGAMI_DEMO_TOKENS={}
AGROGAMI_API_URL=http://127.0.0.1:8000
AGROGAMI_PUBLIC_API_URL=http://127.0.0.1:8000
AGROGAMI_DOCS_DIR=docs
AGROGAMI_MCP_ENABLED=false
AGROGAMI_MCP_HOST=127.0.0.1
AGROGAMI_MCP_PORT=8001
# Set a secret in ignored .env; this token grants Prism viewer reads only.
# Reviewer/admin Prism access reuses AGROGAMI_DEMO_TOKENS with Bearer authorization.
# AGROGAMI_MCP_AUTH_TOKEN=
# Optional explicitly supplied local risk artifact and matching holdout calibrator:
# AGROGAMI_RISK_MODEL_PATH=private_data/artifacts/model.json
# AGROGAMI_CALIBRATOR_PATH=private_data/artifacts/calibrator.json
# AGROGAMI_SHAP_BACKGROUND_PATH=private_data/artifacts/background.json
# AGROGAMI_DEBERTA_CHECKPOINT=model_cache/local-deberta
# AGROGAMI_TROCR_CHECKPOINT=model_cache/local-trocr
# AGROGAMI_LAYOUTLMV3_CHECKPOINT=model_cache/local-layoutlmv3
